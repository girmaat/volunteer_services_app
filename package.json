{
  "name": "volunteer_services_app",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @volunteer_services_app/api --filter @volunteer_services_app/web dev",
    "dev:api": "pnpm --filter @volunteer_services_app/api dev",
    "dev:web": "pnpm --filter @volunteer_services_app/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "db:migrate": "pnpm --filter @volunteer_services_app/api db:migrate",
    "db:seed": "pnpm --filter @volunteer_services_app/api db:seed",
    "db:uat": "pnpm --filter @volunteer_services_app/api db:uat",
    "db:reset": "pnpm --filter @volunteer_services_app/api db:reset",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:api-calls",
    "db:setup": "pnpm --filter @volunteer_services_app/api db:setup",
    "check:api-calls": "node scripts/check-api-calls.mjs",
    "uat:tracker": "node scripts/build-uat-tracker.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1",
    "@types/pg": "^8.23.1",
    "bcryptjs": "3.0.2",
    "pg": "8.16.3",
    "prettier": "^3.6.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "sharp"
    ],
    "overrides": {
      "postcss": ">=8.5.18",
      "postcss-selector-parser": "7.1.6"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}

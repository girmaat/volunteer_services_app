{
  // Terminal > Run Task... lists these. They do the same as the desktop shortcuts.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Volunteer Services: Start (for testing)",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tester/start.ps1",
      "problemMatcher": []
    },
    {
      "label": "Volunteer Services: Open the UAT tracker",
      "type": "shell",
      "command": "start docs/uat/uat-tracker.html",
      "windows": { "command": "Start-Process docs/uat/uat-tracker.html" },
      "problemMatcher": []
    },
    {
      "label": "Volunteer Services: Reset test data",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tester/reset.ps1",
      "problemMatcher": []
    },
    {
      "label": "Volunteer Services: Update to the newest version",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tester/update.ps1",
      "problemMatcher": []
    },
    {
      "label": "Volunteer Services: Set up this computer (first time)",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tester/setup.ps1",
      "problemMatcher": []
    }
  ]
}

# Database connection used for normal app runtime (recommended: limited role, e.g., thankyou_app)
DATABASE_URL=postgres://thankyou_app:password@localhost:5433/thankyou

# Database connection used ONLY for migrations/schema ensures (recommended: schema owner, e.g., thankyou)
# If unset, migrations use DATABASE_URL.
DATABASE_URL_MIGRATIONS=postgres://thankyou:password@localhost:5433/thankyou

# Toggle running ensureDbSchema() on backend startup.
# - true  (default): run schema ensure using DATABASE_URL_MIGRATIONS (or DATABASE_URL)
# - false: skip schema ensure (recommended in production runtime when using a non-owner DB role)
#
# Local/dev recommendation: keep this TRUE so new columns/tables (e.g., slug fields for directories) are created automatically.
RUN_MIGRATIONS=true

# Expected schema owner role name (used for admin UI health checks)
DB_SCHEMA_OWNER=thankyou

# ---- ThankYou API (apps/api) -------------------------------------------
# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=4000

# Postgres connection used by the running app.
DATABASE_URL=postgres://thankyou_app:CHANGE_ME@localhost:5433/thankyou_next
# Optional: a schema-owner role used only by `pnpm db:migrate`. Defaults to DATABASE_URL.
# DATABASE_URL_MIGRATIONS=postgres://thankyou:CHANGE_ME@localhost:5433/thankyou_next

# Origin of the web app (CORS) and base URL used in emailed links.
CORS_ORIGIN=http://localhost:3202
WEB_BASE_URL=http://localhost:3202

# Email transport: "log" (default outside production: printed to the API console), "smtp", or "disabled".
EMAIL_TRANSPORT=log
# Local development only: return verification/reset links to the browser when no email was sent.
# Ignored when NODE_ENV=production.
DEV_EMAIL_LINKS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ThankYou <no-reply@thankyou.local>"

# Sessions
SESSION_DAYS=30

# Seed data password (local/staging only). Default is documented in the README.
# SEED_PASSWORD=

# Geocoding (OpenStreetMap Nominatim, max 1 req/s). Set true to turn it off (tests, offline).
GEOCODING_DISABLED=false


# ---- Security / operations ---------------------------------------------
# Shared secret between the web server and the API so the API can rate-limit by the visitor's IP.
# Set the same value in apps/web/.env.local. Generate with: openssl rand -hex 24
INTERNAL_API_KEY=
# Salt for hashed IPs stored with contact messages and share reports.
IP_HASH_SALT=
# Where contact-form messages are emailed (optional; they are always stored).
SUPPORT_EMAIL=
# Number of proxies in front of the API (e.g. 1 behind Render/Fly), used for req.ip.
TRUST_PROXY=
# Log level: fatal|error|warn|info|debug|trace|silent (defaults: debug locally, info in production)
LOG_LEVEL=
DATABASE_POOL_MAX=10
# Expose /v1/docs and /v1/openapi.json in production (always on outside production).
EXPOSE_API_DOCS=false
# Tests only.
JOBS_DISABLED=false
RATE_LIMIT_DISABLED=false

# Log every API request (by default only warnings/errors and slow paths are logged).
LOG_REQUESTS=false

# Public URL of this API, used in one-click unsubscribe links (List-Unsubscribe).
API_PUBLIC_URL=http://localhost:4000
# Secret for signing unsubscribe links (16+ characters). Required in production.
NOTIFICATION_SECRET=

# Sign-in/sign-up/reset attempts per minute per IP (5 in production). The local E2E stack
# signs in many test users from one IP, so raise it locally, e.g. 60.
AUTH_RATE_LIMIT_PER_MINUTE=5

# Two-step sign-in. MFA_SECRET_KEY encrypts authenticator secrets at rest (required in production;
# changing it turns off everyone's two-step sign-in). MFA_REQUIRED_FOR_STAFF makes platform staff
# turn it on before the admin tools open (default: on in production, off elsewhere).
MFA_SECRET_KEY=
MFA_REQUIRED_FOR_STAFF=

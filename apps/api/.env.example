# ---- ThankYou API (apps/api) -------------------------------------------
# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=4000

# Postgres connection used by the running app.
DATABASE_URL=postgres://thankyou_app:CHANGE_ME@localhost:5433/thankyou_next
# Optional: a schema-owner role used only by `pnpm db:migrate`. Defaults to DATABASE_URL.
# DATABASE_URL_MIGRATIONS=postgres://thankyou:CHANGE_ME@localhost:5433/thankyou_next

# Origin of the web app (CORS) and base URL used in emailed links.
CORS_ORIGIN=http://localhost:3002
WEB_BASE_URL=http://localhost:3002

# Email transport: "log" (default outside production: printed to the API console), "smtp", or "disabled".
EMAIL_TRANSPORT=log
# Local development only: return verification/reset links to the browser when no email was sent.
# Ignored when NODE_ENV=production.
DEV_EMAIL_LINKS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ThankYou <no-reply@thankyou.local>"

# Sessions
SESSION_DAYS=30

# Seed data password (local/staging only). Default is documented in the README.
# SEED_PASSWORD=

# Geocoding (OpenStreetMap Nominatim, max 1 req/s). Set true to turn it off (tests, offline).
GEOCODING_DISABLED=false

# Log every API request with status and duration (development).
LOG_REQUESTS=false

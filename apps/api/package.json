{
  "name": "@thankyou/api",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx src/db/migrate-cli.ts up && tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=10000",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrate-cli.ts up",
    "db:status": "tsx src/db/migrate-cli.ts status",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/migrate-cli.ts reset && tsx src/db/seed.ts",
    "db:create": "tsx src/db/create-db.ts",
    "db:setup": "tsx src/db/create-db.ts && tsx src/db/migrate-cli.ts up && tsx src/db/seed.ts"
  },
  "dependencies": {
    "@thankyou/contracts": "workspace:*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "multer": "^2.0.2",
    "nodemailer": "^10.1.0",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.15.4",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "eslint": "^8.57.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}

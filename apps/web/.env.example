# ---- ThankYou web (apps/web) -------------------------------------------
# Copy to .env.local and adjust.

# Public URL of the API as seen by the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Optional: URL the Next.js server uses to reach the API (if different, e.g. inside Docker).
# API_BASE_URL=http://api:4000

# Force maintenance mode at the edge without calling the API.
# MAINTENANCE_MODE=true
# Cookie Secure flag: defaults to true in production. Override only for local HTTPS testing.
# COOKIE_SECURE=false
# Same value as INTERNAL_API_KEY in apps/api/.env (lets the API see visitor IPs for rate limiting).
INTERNAL_API_KEY=
